@page "{id:int}"
@model TravelList.Pages.Trips.DeleteModel
@{
    ViewData["Title"] = "刪除旅行";
}

<h2 class="page-title mb-4"><i class="bi bi-exclamation-triangle me-2"></i>確認刪除</h2>

<div class="card p-4" style="max-width: 500px;">
    <div class="alert alert-warning d-flex align-items-center" style="border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div>確定要刪除這趟旅行嗎？所有景點都會一起被刪除，此操作無法復原。</div>
    </div>

    <div class="p-3 mb-3" style="background: #f8fafc; border-radius: 12px;">
        <h5 class="fw-bold">@Model.Trip.Title</h5>
        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.Trip.Destination</small>
        <div class="mt-2 text-muted small">
            <i class="bi bi-calendar3 me-1"></i>@Model.Trip.StartDate.ToString("yyyy/MM/dd") ~ @Model.Trip.EndDate.ToString("MM/dd")
            <span class="ms-2"><i class="bi bi-pin-map me-1"></i>@Model.Trip.Spots.Count 個景點</span>
        </div>
    </div>

    <form method="post" asp-route-id="@Model.Trip.Id">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger" style="border-radius: 10px;">
                <i class="bi bi-trash me-1"></i>確認刪除
            </button>
            <a asp-page="/Index" class="btn btn-outline-secondary" style="border-radius: 10px;">
                <i class="bi bi-arrow-left me-1"></i>取消
            </a>
        </div>
    </form>
</div>
