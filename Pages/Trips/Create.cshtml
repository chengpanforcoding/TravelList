@page
@model TravelList.Pages.Trips.CreateModel
@{
    ViewData["Title"] = "新增旅行";
}

<h2 class="page-title mb-4"><i class="bi bi-plus-circle me-2"></i>新增旅行</h2>

<div class="card p-4" style="max-width: 600px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Trip.Title" class="form-label"><i class="bi bi-card-heading me-1"></i>旅行名稱</label>
            <input asp-for="Trip.Title" class="form-control" placeholder="例如：2026 東京自由行" />
            <span asp-validation-for="Trip.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Trip.Destination" class="form-label"><i class="bi bi-geo-alt me-1"></i>目的地</label>
            <input asp-for="Trip.Destination" class="form-control" placeholder="例如：日本東京" />
            <span asp-validation-for="Trip.Destination" class="text-danger"></span>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label asp-for="Trip.StartDate" class="form-label"><i class="bi bi-calendar-event me-1"></i>開始日期</label>
                <input asp-for="Trip.StartDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="Trip.EndDate" class="form-label"><i class="bi bi-calendar-check me-1"></i>結束日期</label>
                <input asp-for="Trip.EndDate" class="form-control" type="date" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>建立旅行</button>
            <a asp-page="/Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>取消</a>
        </div>
    </form>
</div>
